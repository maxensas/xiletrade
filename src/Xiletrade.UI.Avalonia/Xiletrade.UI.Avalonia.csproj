<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <Copyright>Copyright © 2026 maxensas</Copyright>
    <AssemblyTitle>Xiletrade Avalonia User Interface</AssemblyTitle>
    <AssemblyName>Xiletrade</AssemblyName>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <PackageProjectUrl>https://github.com/maxensas/xiletrade</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/maxensas/xiletrade/releases</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Authors>maxensas</Authors>
    <Company>Toolcaps</Company>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>2</WarningLevel>
    <OutputPath>bin\Debug\</OutputPath>
    <DocumentationFile></DocumentationFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <!-- Publish/Release setup -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishAot>true</PublishAot>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishAot)' == 'False'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(PublishAot)' == 'False'">true</EnableCompressionInSingleFile>
    <OptimizationPreference Condition="'$(PublishAot)' == 'True'">size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies Condition="'$(PublishAot)' == 'True'">true</IlcFoldIdenticalMethodBodies>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Notification.AvaloniaUI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="MessageBox.Avalonia" />
    <!--<PackageReference Include="StaticLink.Avalonia" Condition="'$(PublishAot)' == 'True'" />-->
    <!--
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Message.Avalonia" Version="2.0.0" />
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xiletrade.Library\Xiletrade.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UserControls\TaskbarIcon.axaml.cs">
      <DependentUpon>TaskbarIcon.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\WhisperListView.axaml.cs">
      <DependentUpon>WhisperListView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\PopView.axaml.cs">
      <DependentUpon>PopView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\StartView.axaml.cs">
      <DependentUpon>StartView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\UpdateView.axaml.cs">
      <DependentUpon>UpdateView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\RegexView.axaml.cs">
      <DependentUpon>RegexView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\EditorView.axaml.cs">
      <DependentUpon>EditorView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainView.axaml.cs">
      <DependentUpon>MainView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ConfigView.axaml.cs">
      <DependentUpon>ConfigView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\Linux\" />
    <Folder Include="Services\Windows\" />
  </ItemGroup>
  <!--
  <ItemGroup>
    <AvaloniaResource Include="Styles\Media.axaml"/>
  </ItemGroup>
  -->
</Project>
