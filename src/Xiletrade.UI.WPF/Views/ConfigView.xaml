                                <TextBlock Margin="0,-1,2,0" Text="{ext:Localization Config023_tbDev}" Foreground="{StaticResource DisabledForegroundBrush}"/>
                                <CheckBox RenderTransformOrigin="0.357,1.269" IsChecked="{Binding General.DevMode}"/>
                            </DockPanel>

                            <TextBlock Margin="10,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="{ext:Localization Config012_lbLang}" ToolTip="{ext:Localization Config050_lbLangTip}" Style="{StaticResource TextBlockTitle}"/>
