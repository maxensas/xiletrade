                            </Grid>
                            
                            <Grid Margin="10,138,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Margin="0,1,10,0" Text="{ext:Localization Config164_userInterfaceScale}" ToolTip="{ext:Localization Config165_userInterfaceScaleTip}" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource TextBlockTitle}" Cursor=""/>
                                    <Slider Style="{StaticResource sliderFlatConfigPerCent}"
                                            Value="{Binding General.ViewScale}" 
                                            Minimum="1" 
                                            Maximum="2" 
                                            TickFrequency="0.1"
                                            ToolTip="{ext:Localization Config165_userInterfaceScaleTip}"/>
                                </StackPanel>
                                <TextBlock Margin="0,30,0,0" Text="{ext:Localization Config166_priceCheckWindow}" ToolTip="{ext:Localization Config166_priceCheckWindow}" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource TextBlockTitle}"/>


                                <StackPanel Margin="4,55,0,0" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <TextBlock Margin="0,2,10,0" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{ext:Localization Config167_opacity}" ToolTipService.ShowDuration="12000" ToolTip="{ext:Localization Config168_opacityTip}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Light" FontFamily="{StaticResource FontinSmallCaps}"/>
                                    <Slider
                                            Style="{StaticResource sliderFlatConfigPerCent}"
                                            Value="{Binding General.OpacityLevel}" 
                                            Minimum="0.1" 
                                            Maximum="1" 
                                            TickFrequency="0.05"
                                            ToolTip="{ext:Localization Config168_opacityTip}"/>
                                </StackPanel>
                                <StackPanel Margin="4,85,0,0" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <ToggleButton Content="{ext:Localization Main101_btnCloseAuto}" ToolTip="{ext:Localization Config169_autoCloseTip}" IsChecked="{Binding General.AutoCloseMain}" Style="{StaticResource ToggleSwitchContentSmall}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <ToggleButton Margin="0,8,0,0" Content="{ext:Localization Main240_AsyncMarket}" ToolTip="{ext:Localization Main241_AsyncMarketTip}" IsChecked="{Binding General.AsyncMarketDefault}" Style="{StaticResource ToggleSwitchContentSmall}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <ToggleButton Margin="0,8,0,0" Content="{ext:Localization Main252_FastInputs}" ToolTip="{ext:Localization Main253_FastInputsTip}" IsChecked="{Binding General.FastInputs}" Style="{StaticResource ToggleSwitchContentSmall}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </StackPanel>
                            </Grid>
