                            <ComboBox x:Name="cbMaxOthers" Height="22" Margin="70,295,473,53" HorizontalContentAlignment="Center" Visibility="Hidden"/>
                            <StackPanel Orientation="Horizontal" Margin="254,87,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Margin="0,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource TextBlockTitle}" Text="{ext:Localization Config025_lbWhisper}" ToolTip="{ext:Localization Config055_lbWhisperTip}"/>
                                <ToggleButton Margin="10,2,0,0" Content="{ext:Localization Config028_checkWhisperAuto}" ToolTip="{ext:Localization Config058_checkWhisperAutoTip}" IsChecked="{Binding General.AutoWhisper}" Style="{StaticResource ToggleSwitchContentSmall}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </StackPanel>
                            <StackPanel Margin="254,112,0,0" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
