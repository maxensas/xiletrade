                                <ToggleButton Margin="164,45,0,0" Content="{ext:Localization Config032_checkPseudo}" ToolTip="{ext:Localization Config061_checkPseudoTip}" IsChecked="{Binding General.CheckPseudoAffix}" Style="{StaticResource ToggleSwitchContentSmall}" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding General.GameIndex, Converter={StaticResource poe1VisibilityConverter}}"/>
