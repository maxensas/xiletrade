                            <ToggleButton Margin="263,38,0,0" Content="{ext:Localization Config026_checkStartupMessage}" ToolTip="{ext:Localization Config056_checkStartupMessageTip}" IsChecked="{Binding General.StartupMessage}" Style="{StaticResource ToggleSwitchContentSmall}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
