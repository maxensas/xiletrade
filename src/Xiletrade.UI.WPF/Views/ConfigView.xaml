                                <ToggleButton Margin="10,2,0,0" Content="{ext:Localization Config161_checkLeftClick}" ToolTip="{ext:Localization Config156_checkCtrlWheel}" IsChecked="{Binding General.CtrlWheel}" Style="{StaticResource ToggleSwitchContentSmall}" VerticalAlignment="Top"/>
