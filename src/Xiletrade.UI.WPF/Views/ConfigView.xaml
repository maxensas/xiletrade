                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="9">
                                                                <Setter Property="Source" Value="{StaticResource FlagChinese}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="10">
                                                                <Setter Property="Source" Value="{StaticResource FlagJapanese}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Margin="5,0,0,0" Text="{Binding Lang}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox Margin="144,37,0,0" Height="26" Width="52" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center" ToolTip="Optional : Select the trading gateway after selecting the language." ItemsSource="{Binding General.Gateway}" SelectedIndex="{Binding General.GatewayIndex}"/>

