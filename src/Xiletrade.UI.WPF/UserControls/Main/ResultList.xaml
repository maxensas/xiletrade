<UserControl x:Class="Xiletrade.UI.WPF.UserControls.Main.ResultList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:t="clr-namespace:Xiletrade.Library.ViewModels.Main;assembly=Xiletrade.Library"
             xmlns:ext="clr-namespace:Xiletrade.UI.WPF.Util.Extensions"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:helper="clr-namespace:Xiletrade.UI.WPF.Util.Helper"
             xmlns:uc="clr-namespace:Xiletrade.UI.WPF.UserControls.Main"
             xmlns:local="clr-namespace:Xiletrade.UI.WPF.UserControls.Main"
             mc:Ignorable="d" d:DesignHeight="336" d:DesignWidth="505"
             d:DataContext="{d:DesignInstance Type=t:MainViewModel}">
    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="505">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <!-- header of the result list -->
        <StackPanel Margin="0,0,0,5" Orientation="Horizontal" Grid.Row="0" Height="15">
            <TextBlock Text="{ext:Localization Main087_lblPrice}" HorizontalAlignment="Left" Margin="30,1,0,0" VerticalAlignment="Top" FontSize="10" Style="{StaticResource TextBlockTitle}" Foreground="{StaticResource ForegroundBrush}" Visibility="Visible" Width="79"/>
            <TextBlock Text="iLvl" HorizontalAlignment="Left" Margin="0,1,0,0" VerticalAlignment="Top" FontSize="10" Style="{StaticResource TextBlockTitle}" Foreground="{StaticResource ForegroundBrush}" Visibility="Visible" Width="40"/>
            <TextBlock Text="{ext:Localization Main066_tbQuality}" HorizontalAlignment="Left" Margin="0,1,0,0" VerticalAlignment="Top" FontSize="10" Style="{StaticResource TextBlockTitle}" Foreground="{StaticResource ForegroundBrush}" Visibility="Visible" Width="70"/>
            <TextBlock Text="{ext:Localization Main088_lblIndexed}" HorizontalAlignment="Left" Margin="0,1,0,0" VerticalAlignment="Top" FontSize="10" Style="{StaticResource TextBlockTitle}" Foreground="{StaticResource ForegroundBrush}" Visibility="Visible" Width="93" TextAlignment="Left"/>
            <TextBlock Text="{ext:Localization Main089_lblSellers}" HorizontalAlignment="Left" Margin="0,1,0,0" VerticalAlignment="Top" FontSize="10" Style="{StaticResource TextBlockTitle}" Foreground="{StaticResource ForegroundBrush}" Visibility="Visible" Width="125"/>
        </StackPanel>
        <ListBox Grid.Row="1" FontFamily="Consolas" BorderThickness="1" AlternationCount="2"
             ItemsSource="{Binding Path=Result.DetailList}"
             d:ItemsSource="{d:SampleData ItemCount=20}"
             VirtualizingStackPanel.IsVirtualizing="True"
             VirtualizingStackPanel.VirtualizationMode="Recycling"
             HorizontalContentAlignment="Stretch">
            <i:Interaction.Behaviors>
                <!-- end of the list reached : next results fetched, as with the fetch button of the detail view -->
                <helper:ScrollEndCommandBehavior Command="{Binding Result.FetchCommand}" IsEnabled="{Binding Result.FetchDetailIsEnabled}"/>
            </i:Interaction.Behaviors>
            <ListBox.Resources>
                <!-- item level, quality, age, seller : darker once the hideout of the seller has been visited -->
                <Style x:Key="SaleInfoText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{StaticResource GrayForegoundBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisited}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GrayDarkForegroundBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="3"/>
                </Style>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <!-- the padding is on the tooltip wrapper of the template, so the tooltip covers the whole item -->
                    <Setter Property="Padding" Value="0"/>
                    <Style.Triggers>
                        <!-- Index even -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <!--<Setter Property="Foreground" Value="{StaticResource ForegroundTextBrush}"/>-->
                        </Trigger>
                        <!-- Index odd -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <!--<Setter Property="Foreground" Value="{StaticResource ForegroundTextBrush}"/>-->
                            <Setter Property="Background" Value="{DynamicResource BlackBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding FgColor}" Value="Red">
                            <Setter Property="Foreground" Value="Red"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FgColor}" Value="YellowGreen">
                            <Setter Property="Foreground" Value="YellowGreen"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FgColor}" Value="LimeGreen">
                            <Setter Property="Foreground" Value="LimeGreen"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FgColor}" Value="Yellow">
                            <Setter Property="Foreground" Value="Yellow"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FgColor}" Value="DeepSkyBlue">
                            <Setter Property="Foreground" Value="DeepSkyBlue"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FgColor}" Value="DarkRed">
                            <Setter Property="Foreground" Value="DarkRed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FgColor}" Value="LightGray">
                            <Setter Property="Foreground" Value="LightGray"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FgColor}" Value="Azure">
                            <Setter Property="Foreground" Value="Azure"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FgColor}" Value="White">
                            <Setter Property="Foreground" Value="White"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FgColor}" Value="Gray">
                            <Setter Property="Foreground" Value="Gray"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Resources>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- the tooltip is on this wrapper : it covers the whole item (padding included), the hideout Button keeps its own tooltip.
                         the padding is the same above and below the content : the line is vertically centered -->
                    <Border Padding="2,1,0,1" Background="Transparent" Tag="{Binding Tag}"
                            ToolTipService.BetweenShowDelay="0" ToolTipService.InitialShowDelay="0" 
                            ToolTipService.HorizontalOffset="40" ToolTipService.VerticalOffset="40"
                            MouseLeave="ResultItem_MouseLeave">
                        <Border.ToolTip>
                            <ToolTip Style="{StaticResource resultItem}">
                                <uc:ResultItem DataContext="{Binding Item}" />
                            </ToolTip>
                        </Border.ToolTip>
                        <Grid Tag="{Binding Tag}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <!-- amount -->
                                <ColumnDefinition Width="30"/>
                                <!-- currency -->
                                <ColumnDefinition Width="25"/>
                                <!-- hideout -->
                                <ColumnDefinition Width="35"/>
                                <!-- item level -->
                                <ColumnDefinition Width="30"/>
                                <!-- quality / count -->
                                <ColumnDefinition Width="48"/>
                                <!-- age -->
                                <ColumnDefinition Width="60"/>
                                <!-- age label -->
                                <ColumnDefinition Width="80"/>
                                <!-- account -->
                                <ColumnDefinition Width="144"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Margin="0,-1,0,0" FontSize="14" d:Text="200" Text="{Binding Info.Amount}" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock.ToolTip>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Info.Amount"/>
                                                <Binding Path="Currency.Name"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <Image Margin="6,0,0,0" x:Name="tradeCur" Source="{Binding Currency, Converter={StaticResource imageSourceConverter}}" d:Source="{StaticResource ImgDivine}" Width="16" Height="16" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" d:Visibility="Visible" Visibility="{Binding Source={RelativeSource Self}, Path=Source, Converter={StaticResource null2CollapseConverter}}"/>
                            <Button Grid.Row="0" Grid.Column="2" Height="13" Width="15" Command="{Binding DataContext.Result.TravelToHideoutCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="{ext:Localization Main310_TravelToHideout}" Cursor="Hand">
                                <Viewbox Width="10" Height="10" Cursor="">
                                    <Path Style="{StaticResource HouseIcon}" Stretch="Uniform"/>
                                </Viewbox>
                            </Button>
                            <TextBlock Margin="0,-1,0,0" FontSize="14" d:Text="83" Text="{Binding Item.ItemLevel}" Style="{StaticResource SaleInfoText}" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Margin="0,-1,0,0" FontSize="14" d:Text="20" Text="{Binding Info.QualityOrCount}" Style="{StaticResource SaleInfoText}" Grid.Row="0" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Margin="0,-1,0,0" FontSize="14" d:Text="5" Text="{Binding Info.Age}" Style="{StaticResource SaleInfoText}" Grid.Row="0" Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Margin="8,-1,0,0" FontSize="14" d:Text="days" Text="{Binding Info.AgeLabel}" Style="{StaticResource SaleInfoText}" Grid.Row="0" Grid.Column="6" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Margin="0,-1,0,1" FontSize="14" d:Text="Samathor" Text="{Binding Info.Account}" Style="{StaticResource SaleInfoText}" Grid.Row="0" Grid.Column="7" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
