<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Copyright>Copyright © 2026 maxensas</Copyright>
    <Company>Toolcaps</Company>
    <Authors>maxensas</Authors>
    <AssemblyTitle>Xiletrade Updater</AssemblyTitle>
    <PackageProjectUrl>https://github.com/maxensas/xiletrade</PackageProjectUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Publish/Release setup -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishAot>true</PublishAot>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishAot)' == 'False'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(PublishAot)' == 'False'">true</EnableCompressionInSingleFile>
    <OptimizationPreference Condition="'$(PublishAot)' == 'True'">size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies Condition="'$(PublishAot)' == 'True'">true</IlcFoldIdenticalMethodBodies>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' != 'Release'" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" />
    <PackageReference Include="MessageBox.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="StaticLink.Avalonia" Condition="'$(PublishAot)' == 'True'" />
  </ItemGroup>
</Project>

